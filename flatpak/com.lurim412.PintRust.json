{
  "app-id": "com.lurim412.PintRust",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "pintrust",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=dri",
    "--talk-name=org.freedesktop.portal.Desktop",
    "--talk-name=org.freedesktop.secrets",
    "--filesystem=xdg-download"
  ],
  "build-options": {
    "build-args": [
      "--share=network"
    ],
    "env": {
      "CARGO_HOME": "/run/build/rust-toolchain/cargo",
      "RUSTUP_HOME": "/run/build/rust-toolchain/rustup"
    }
  },
  "cleanup": [
    "/bin/cargo",
    "/bin/rustc",
    "/bin/rustup",
    "/include",
    "/lib/pkgconfig",
    "/share/pkgconfig",
    "/share/aclocal",
    "/share/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/vala",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "rust-toolchain",
      "buildsystem": "simple",
      "build-commands": [
        "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --no-modify-path --default-toolchain stable",
        "mkdir -p /app/bin",
        "ln -sf /run/build/rust-toolchain/cargo/bin/cargo /app/bin/cargo",
        "ln -sf /run/build/rust-toolchain/cargo/bin/rustc /app/bin/rustc",
        "ln -sf /run/build/rust-toolchain/cargo/bin/rustup /app/bin/rustup",
        "cargo --version"
      ]
    },
    {
      "name": "pintrust",
      "buildsystem": "meson",
      "config-opts": [
        "--buildtype=release",
        "-Dprofile=release"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            ".cargo-home",
            ".flatpak-builder",
            ".git",
            "build",
            "build-appimage",
            "build-tools",
            "dist",
            "target"
          ]
        }
      ]
    }
  ]
}
